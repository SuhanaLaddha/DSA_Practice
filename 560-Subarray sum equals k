class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int n=nums.size();
        unordered_map<int,int>mp;
        mp[0]=1;
        int count=0;
        int prefix=0;
        for(int x:nums){
            prefix+=x;
            int needed=prefix-k;
            if(mp.find(needed)!=mp.end()){
                count+=mp[needed];
            }
            mp[prefix]++;
        }
        return count;
    }
};
