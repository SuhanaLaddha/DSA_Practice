class Solution {
public:
    int MOD = 1337;

    int power(int a, int n) {
        int res = 1;
        a %= MOD;

        while (n > 0) {
            if (n & 1) {
                res = (res * a) % MOD;
            }

            a = (a * a) % MOD;
            n >>= 1;
        }

        return res;
    }

    int superPow(int a, vector<int>& b) {
        int ans = 1;

        for (int digit : b) {
            ans = power(ans, 10);               // ans^10
            ans = (ans * power(a, digit)) % MOD;
        }

        return ans;
    }
};
