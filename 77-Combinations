class Solution {
    vector<vector<int>> ans;
    void comb(int idx,int n,int k,vector<int> &res){
        if(res.size()==k){
            ans.push_back(res);
            return;
            
        }
        for(int i=idx;i<n+1;i++){
            res.push_back(i);
            comb(i+1,n,k,res);
            res.pop_back();
        }
    }
public:
    vector<vector<int>> combine(int n, int k) {
        vector<int> res;
        comb(1,n,k,res);
        return ans;
    }
};
