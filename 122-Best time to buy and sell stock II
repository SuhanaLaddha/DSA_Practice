class Solution {
    int helper(int day , int state , vector<int>& prices,vector<vector<int>>&dp){
        if(day==prices.size()){
            return 0;
        }
        if(dp[day][state]!=-1){
            return dp[day][state];
        }
        if(state==1){
            int buy=-prices[day]+helper(day+1,0,prices,dp);
            int skip=helper(day+1,1,prices,dp);
            return dp[day][state]=max(buy,skip);
        }
        else{
            int sell=prices[day]+helper(day+1,1,prices,dp);
            int hold=helper(day+1,0,prices,dp);
            return dp[day][state]= max(sell,hold);
        }

    }
public:
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        vector<vector<int>>dp(n,vector<int>(2,-1));
        return helper(0,1,prices,dp);
    }
};



