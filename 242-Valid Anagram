#include<bits/stdc++.h>
using namespace std;
int main(){
    string s,t;
    cin>>s>>t;
    int freq1[256]={0};
    int freq2[256]={0};
    if(s.length()!=t.length()){
        cout<<"False";
        return 0 ;
    }
    for(int i=0;i<s.length();i++){
        freq1[s[i]]++;
        freq2[t[i]]++;
    }
    for(int i=0;i<256;i++){
        if(freq1[i]!=freq2[i]){
            cout<<"False";
            return 0;
        }
    }
    cout<<"True";
    return 0;
}
