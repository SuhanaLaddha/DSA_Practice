class Solution {
public:
    bool checkDivisibility(int n) {
        int sum=0;
        int product=1;
        int m=n;
        while(n>0){
            int rem=n%10;
            sum+=rem;
            product*=rem;
            n/=10;
        }
        if(m%(sum+product)==0){
            return true;
        }else{
            return false;
        }
    }
};
